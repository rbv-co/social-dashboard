# AGENDAMENTO DOS ROBÔS DO COLETOR, NA VPS. Instalar com:
#   install -m 644 -o root -g root /opt/robos/social-dashboard/coletor/vps/robos.cron /etc/cron.d/robos-social-dashboard
# Substitui os `schedule:` dos workflows do GitHub Actions (que passaram a só aceitar disparo manual).
# Leia coletor/vps/LEIA-ME-ROBOS.txt antes de mexer. Formato de /etc/cron.d: tem a coluna do usuário.
#
# Horários em UTC, iguais aos dos workflows de origem (a VPS roda em UTC). Cada linha:
#   <cron> root <wrapper> <nome> <limite em minutos> -- <comando>
# O <nome> é o lock: duas linhas com o mesmo nome nunca rodam juntas (a segunda é pulada, não enfileirada).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ── O site vesselbrasil.com.br (nginx na VPS desde 2026-10-10; saiu da Vercel) ─────────────────────────────────
# Publicação: a cada 5 min confere se o `main` do vessel-brasil mudou e, se mudou, publica (testes + travas do SELO,
# release atômico, reversão automática). Em dia = silêncio. Substitui o poll de 10 min que rodava no Actions.
# Doc: vessel-brasil/vps/LEIA-ME-VPS.txt.
*/5 * * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh publicar-o-site 15 -- /usr/local/sbin/deploy-vesselbrasil --se-mudou

# Fotos do selo (certificado): busca as fotos das bolsas dos lotes novos (Zoho/Bling), commita e dá push no vessel-brasil
# (chave de deploy COM ESCRITA só nesse repo) e manda publicar. A cada 5 min no lugar de hora em hora + `lote-novo` do banco
# (que acordava o Actions por repository_dispatch): a maioria das rodadas não acha nada para fazer.
2-59/5 * * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh fotos-do-selo 60 -- node coletor/fotos-do-selo-do-bling.mjs

# ── De hora em hora ─────────────────────────────────────────────────────────────────────────────────────────────
# Notas dos pedidos (data da venda): janela de 7 dias, idempotente (workflow notas-dos-pedidos).
23 * * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh notas-dos-pedidos 120 -- node coletor/notas-dos-pedidos.mjs --dias=7

# Pedidos da Vessel: vendedores do Bling antes dos pedidos. Conferência ao vivo (3 dias) a cada hora e varredura
# profunda (30 dias) às 07:34. No Actions as duas caíam no mesmo grupo de concorrência; aqui elas têm o mesmo nome
# (= mesmo lock) e minutos diferentes. O minuto 29 (e não 23) afasta este robô do das notas: os dois falam com o Bling.
29 * * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh pedidos-da-vessel 90 -- bash -c 'set -e; node coletor/trazer-vendedores-do-bling.mjs; node coletor/trazer-pedidos-do-bling.mjs --dias=3'
34 7 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh pedidos-da-vessel 90 -- bash -c 'set -e; node coletor/trazer-vendedores-do-bling.mjs; node coletor/trazer-pedidos-do-bling.mjs --dias=30'

# Pedidos da Loja Shopify: ao vivo (3 dias) em toda hora EXCETO 07h, onde a varredura profunda (30 dias) ocupa o
# lugar. No Actions as duas coincidiam às 07:41 e a segunda esperava na fila; aqui a segunda seria pulada, então
# a hora 7 é da profunda.
41 0-6,8-23 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh pedidos-da-shopify 30 -- node coletor/trazer-pedidos-da-shopify.mjs --dias=3
41 7 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh pedidos-da-shopify 30 -- node coletor/trazer-pedidos-da-shopify.mjs --dias=30

# ── Diários ─────────────────────────────────────────────────────────────────────────────────────────────────────
# 03h12 em Campinas: cópia de segurança do banco para o Zoho (domingo leva o histórico de métrica; dia 1º confere).
12 6 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh copia-do-banco 60 -- bash coletor/vps/copia-do-banco.sh

# Faxina do Storage + vigia de armazenamento.
23 5 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh faxina-storage 15 -- bash coletor/vps/faxina-storage.sh

# Meta Ads: planilha para o Zoho WorkDrive.
42 9 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh meta-ads-no-zoho 20 -- node coletor/meta-ads-no-zoho.mjs

# Cards do comercial.
40 9 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh cards-comercial-diario 15 -- node coletor/atualizar-cards-comercial.mjs

# Relatórios comerciais (o --backfill vazio é o que o workflow passava no cron).
52 8 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh relatorios-comerciais 120 -- node coletor/relatorios-comerciais.mjs --backfill=

# Vigia de problemas do Meta (leitura + upsert, sem IA).
7 7 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh vigia-problemas-meta 20 -- node coletor/vigia-problemas-meta.mjs

# ── Semanais e relatório diário (migrados do Actions em 2026-10-10) ───────────────────────────────────────────
# O GitHub atrasava estes agendamentos em horas (o OPR de 08:00 UTC chegou a rodar às ~14:07); aqui rodam no minuto.
# Todos gastam IA ou mandam mensagem: o lock do nome impede rodada dupla.

# Coletor de Notícias (segunda 09:07 UTC): 7 passos, falha de um não aborta os outros. Opus + web search: ~2,5 h no máximo.
7 9 * * 1 root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh coletor-noticias 160 -- bash coletor/vps/coletor-noticias.sh

# Gestor Comercial (briefing semanal, segunda 09:23 UTC).
23 9 * * 1 root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh gestor-comercial 20 -- node coletor/gestor-comercial.mjs

# Sugestão de interesses (domingo 10:34 UTC; só o modo normal. As sondas e o --dry eram do botão manual).
34 10 * * 0 root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh sugerir-interesses 20 -- node coletor/sugerir-interesses.mjs

# Relatório OPR diário (05h BRT = 08:00 UTC): gera o PNG e manda para o grupo pela Z-API. Node 22 de propósito (o 24 deu
# "Illegal base64 character" no send-image). ⚠️ Falha todo dia enquanto a instância Z-API estiver com o WhatsApp
# desconectado (reconectar = ler o QR na Z-API); o alerta só avisa na 1ª falha, não 1 por dia.
0 8 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh opr-diario 10 -- node coletor/gerar-opr-diario.mjs

# Budget IA (análise diária de tráfego, 08h BRT). Gasta IA: nunca duas rodadas juntas (o lock do nome cuida disso).
0 11 * * * root /opt/robos/social-dashboard/coletor/vps/rodar-robo.sh budget-ia 20 -- node coletor/budget-ia.mjs
