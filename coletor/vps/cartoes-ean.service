# /etc/systemd/system/cartoes-ean.service — vigia da fila de Cartões EAN (ver cartoes-ean-vigia.sh).
# Os limites existem porque a VPS também roda o PDV, o Chatwoot e o monitor: o robô (Chrome + rembg) nunca pode
# sufocá-los. Passou de 4 GB (dois robôs + Chrome + rembg), o systemd mata SÓ o robô; o pedido volta à fila (recolocar_travados) e o resto segue.
[Unit]
Description=Robô de Cartões EAN (vigia da fila)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/cartoes-ean.env
ExecStart=/opt/cartoes-ean/social-dashboard/coletor/vps/cartoes-ean-vigia.sh
Restart=always
RestartSec=15
Nice=10
CPUWeight=50
MemoryHigh=3000M
MemoryMax=4G

[Install]
WantedBy=multi-user.target
